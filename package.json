{
  "name": "streamqa-cypress-ts",
  "version": "1.0.0",
  "private": true,
  "description": "Демонстрационный проект автоматизации тестирования B2B streaming-платформы на Cypress и TypeScript",
  "scripts": {
    "start": "node app/server.js",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test": "start-server-and-test start http://localhost:3000 cy:run",
    "test:smoke": "start-server-and-test start http://localhost:3000 'cypress run --spec cypress/e2e/smoke.cy.ts'",
    "test:api": "start-server-and-test start http://localhost:3000 'cypress run --spec cypress/e2e/api.cy.ts'",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "cypress": "^15.17.0",
    "prettier": "^3.8.4",
    "start-server-and-test": "^3.0.11",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
